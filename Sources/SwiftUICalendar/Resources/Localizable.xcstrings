      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Range start" } } }
    },
    "Calendar.Day.Range.end": {
      "extractionState": "manual",
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Range end" } } }
    },
    "Calendar.Day.Range.interior": {
      "extractionState": "manual",
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Within selected range" } } }
    },
    "Calendar.Day.Range.startAndEnd": {
      "extractionState": "manual",
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Range start and end" } } }
    },
    "Calendar.Day.SecondaryDate": {
      "comment": "Alternate calendar date. First %@ is the localized calendar name; second %@ is its full date.",
      "extractionState": "manual",
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "%@, %@" } } }
    },
    "Calendar.Navigation.PreviousYears": {
      "extractionState": "manual",
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Previous years" } } }
    },
    "Calendar.Navigation.NextYears": {
      "extractionState": "manual",
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Next years" } } }
    },
    "Calendar.Navigation.Month.Selected": {
      "comment": "VoiceOver name for the month control. %@ is the displayed month name.",
      "extractionState": "manual",
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Month, %@" } } }
    },
    "Calendar.Navigation.Month.ChangeHint": {
      "comment": "Outcome of activating the month control, without repeating VoiceOver gestures.",
      "extractionState": "manual",
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Choose another month" } } }
    },
    "Calendar.Navigation.PreviousYear": {
