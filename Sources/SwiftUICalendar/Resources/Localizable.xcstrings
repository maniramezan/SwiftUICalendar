    "Calendar.Selection.RangeStart": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Range starts on %@. Choose an end date."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zeitraum beginnt am %@. Wähle ein Enddatum."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بازه از %@ آغاز می‌شود. تاریخ پایان را انتخاب کنید."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدأ النطاق في %@. اختر تاريخ النهاية."
