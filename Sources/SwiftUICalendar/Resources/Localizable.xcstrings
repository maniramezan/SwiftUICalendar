    },
    "Calendar.Navigation.NextYear": {
      "extractionState": "manual",
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Next year" } } }
    },
    "Calendar.Navigation.PreviousMonth": {
      "extractionState": "manual",
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Previous month" } } }
    },
    "Calendar.Navigation.NextMonth": {
      "extractionState": "manual",
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Next month" } } }
    },
    "Calendar.Selection.RangeStart": {
      "extractionState": "manual",
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Range starts on %@. Choose an end date." } } }
    },
    "Calendar.Selection.RangeComplete": {
      "extractionState": "manual",
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Selected range, %@ to %@." } } }
    },
    "Calendar.Day.Secondary": {
      "comment": "VoiceOver description of a day cell's secondary (alternate calendar) label. %@ is the secondary label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Secondary %@"
          }
        }
      }
    },
    "Calendar.Day.Selected": {
      "comment": "VoiceOver trait appended to a day cell that is currently selected",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected"
          }
        }
      }
    },
    "Calendar.Day.Today": {
      "comment": "VoiceOver trait appended to the day cell representing today",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today"
          }
        }
      }
    },
    "Calendar.Done": {
      "comment": "Button that confirms the year selection and dismisses the year picker",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        }
      }
    },
    "Calendar.Navigation.Next": {
      "comment": "VoiceOver label for the button that advances to the next month/year",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next"
          }
        }
      }
    },
    "Calendar.Navigation.Previous": {
      "comment": "VoiceOver label for the button that returns to the previous month/year",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Previous"
          }
        }
      }
    },
    "Calendar.Today": {
      "comment": "Button to jump to today's date\"",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today"
          }
        }
      }
    },
    "Calendar.Navigation.Year.Selected": {
      "comment": "VoiceOver label announcing the currently selected year, e.g. \"Selected year, 2026\"",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected year, %@"
          }
        }
      }
    },
    "Calendar.Navigation.Year.ChangeHint": {
      "comment": "VoiceOver hint describing that activating the control lets the user change the selected year",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose another year"
          }
        }
      }
    }
  },
  "version": "1.1"
